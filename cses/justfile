bin_dir := "src/bin"
test_dir := "tests"
template := "template.rs"

new name:
  cp {{ template }} {{ bin_dir }}/{{ name }}.rs
  mkdir -p {{ test_dir }}/{{ name }}
  touch {{ test_dir }}/{{ name }}/1.in {{ test_dir }}/{{ name }}/1.out
  @echo "Created {{ bin_dir }}/{{ name }}.rs — edit tests/{{ name }}/1.in and 1.out with the sample case"

build name:
  cargo build --bin {{ name }}

build-release name:
  cargo build --release --bin {{ name }}

run name:
  cargo run --quiet --bin {{ name }}

run-file name file:
  cargo run --quiet --bin {{ name }} -- {{ test_dir }}/{{ name }}/{{ file }}

test name:
  #!/usr/bin/env bash
  set -euo pipefail

  cargo build --quiet --bin {{ name }}

  pass=0
  fail=0
  tmpdir=$(mktemp -d)
  trap 'rm -rf "$tmpdir"' EXIT

  for infile in {{ test_dir }}/{{ name }}/*.in; do
    base=$(basename "$infile" .in)
    expected="{{ test_dir }}/{{ name }}/${base}.out"
    actual="$tmpdir/${base}.out"

    if ./target/debug/{{ name }} "$infile" > "$actual"; then
      if diff -q "$expected" "$actual" >/dev/null; then
        echo "[PASS] $base"
        pass=$((pass + 1))
      else
        echo "[FAIL] $base"
        echo
        delta --paging=never --line-numbers "$expected" "$actual" || true
        echo
        fail=$((fail + 1))
      fi
    else
      status=$?
      echo "[FAIL] $base (program exited with status $status)"
      echo
      echo "--- output ---"
      cat "$actual"
      echo "--------------"
      echo
      fail=$((fail + 1))
    fi
  done

  echo "$pass passed, $fail failed"
  [ "$fail" -eq 0 ]

clean:
  cargo clean
